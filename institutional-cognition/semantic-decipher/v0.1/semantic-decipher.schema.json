{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymehall.org/schemas/semantic-decipher.v0.1.schema.json",
  "title": "Semantic Decipher Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "source", "readings", "intentionality", "reception", "observation_basis", "access_envelope", "evidence_status", "interpretive_distance", "methodological_limitations", "counter_readings", "unresolved", "authority_posture"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "provenance_refs"],
      "properties": {
        "claim": {"type": "string"},
        "provenance_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "status", "confidence", "rationale"],
        "properties": {
          "mode": {"enum": ["literal", "metaphorical", "symbolic", "dual_coded", "other"]},
          "status": {"enum": ["supported", "plausible", "contested", "unsupported", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string"}
        }
      }
    },
    "intentionality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate", "evidence_refs"],
      "properties": {
        "status": {"enum": ["explicit", "inferred", "unknown", "contested"]},
        "candidate": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reception": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "reading", "evidence_refs"],
        "properties": {
          "audience": {"type": "string"},
          "reading": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "observation_basis": {"enum": ["direct_source", "repository_native", "search_index", "quotation", "secondary_source", "participant_report", "mixed", "unknown"]},
    "access_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_tools", "limitations"],
      "properties": {
        "available_tools": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_status": {"enum": ["observed", "indirectly_supported", "unavailable", "undiscovered", "contradicted", "insufficient", "mixed"]},
    "interpretive_distance": {"enum": ["explicit_source_statement", "close_inference", "contextual_inference", "speculative_inference", "unknown"]},
    "methodological_limitations": {"type": "array", "items": {"type": "string"}},
    "counter_readings": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "recommended_disposition": {"enum": ["archive_only", "compare", "request_review", "eligible_for_admission", "none"]},
    "authority_posture": {"const": "analysis_only"}
  }
}