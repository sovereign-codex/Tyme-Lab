{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymehall.org/schemas/tyme-attention-orientation.v0.schema.json",
  "title": "TYME Attention Orientation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orientation_id",
    "observed_at",
    "repository_ref",
    "repository_head_sha",
    "supersedes_orientation_id",
    "current_frontier",
    "why_now",
    "current_state",
    "current_stewardship",
    "blocked_by",
    "next_gate",
    "waiting_dependents",
    "human_review_required_now",
    "human_execution_required_now",
    "next_human_gate",
    "do_not_touch",
    "revisit_when",
    "evidence_refs",
    "claims",
    "one_current_steward_action"
  ],
  "properties": {
    "orientation_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "repository_ref": {"type": "string", "minLength": 1},
    "repository_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "supersedes_orientation_id": {"type": ["string", "null"]},
    "current_frontier": {"type": "string", "minLength": 1},
    "why_now": {"type": "string", "minLength": 1},
    "current_state": {"enum": ["NOW", "NEXT", "WAITING", "DORMANT", "DO_NOT_TOUCH"]},
    "current_stewardship": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "next_gate": {"type": "string", "minLength": 1},
    "waiting_dependents": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "human_review_required_now": {"type": "boolean"},
    "human_execution_required_now": {"type": "boolean"},
    "next_human_gate": {"type": "string", "minLength": 1},
    "do_not_touch": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "revisit_when": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "epistemic_posture", "evidence_refs"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "epistemic_posture": {"enum": ["known", "inferred", "unresolved"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "one_current_steward_action": {"type": "string", "minLength": 1}
  }
}
